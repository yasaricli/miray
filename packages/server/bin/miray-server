#!/usr/bin/env node

import { MirayServer } from '../src/index.js';
import { createRequire } from 'module';

const require = createRequire(import.meta.url);
const pkg = require('../package.json');

// Parse command line arguments
function parseArgs() {
  const args = process.argv.slice(2);
  const options = {};

  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--version' || args[i] === '-v') {
      console.log(pkg.version);
      process.exit(0);
    } else if (args[i] === '--port' || args[i] === '-p') {
      options.port = parseInt(args[i + 1], 10);
      i++;
    } else if (args[i] === '--host' || args[i] === '-h') {
      options.host = args[i + 1];
      i++;
    } else if (args[i] === '--username' || args[i] === '-u') {
      options.username = args[i + 1];
      i++;
    } else if (args[i] === '--password') {
      options.password = args[i + 1];
      i++;
    }
  }

  return options;
}

// Validate required auth parameters
function validateAuth(options) {
  if (options.username && !options.password) {
    console.error('[Server] Error: --password is required when --username is provided');
    process.exit(1);
  }
  if (options.password && !options.username) {
    console.error('[Server] Error: --username is required when --password is provided');
    process.exit(1);
  }
}

// Start server
const options = parseArgs();
validateAuth(options);
const server = new MirayServer(options);
server.start().catch((error) => {
  console.error('[Server] Failed to start:', error);
  process.exit(1);
});
